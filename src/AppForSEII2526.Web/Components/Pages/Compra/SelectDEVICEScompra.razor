@page "/compra/seleccion" 

@using AppForSEII2526.Web.Data @*//NO acceder a api*@
@using Microsoft.AspNetCore.Authorization
@using AppForSEII2526.Web.API

@*DEPENDENCIAS: las herramientas que registramos en Program.cs*@
@inject ILogger<SelectDEVICEScompra> Logger
@*el carrito de la compra (PurchaseState)*@
@inject PurchaseStateContainer PurchaseState 
@inject IHttpClientFactory ClientFactory
@inject NavigationManager NavigationManager
@inject AppForSEII2526APIClient client 


@*COMENTARIO: AQUI TODO LO DE HTML*@

@* @attribute [Authorize] *@  @*Esta línea te obliga a poner usuario y contraseña*@

@* FORZAMOS QUE SEA PÚBLICO: Esto anula cualquier bloqueo de seguridad heredado *@
@attribute [AllowAnonymous] 

<div class="text-center mb-4">
    <h1 class="display-4">Comprar Dispositivos</h1>
    <p class="lead">Selecciona los mejores dispositivos para tu colección.</p>
</div>


<div class="container">

    <div class="row">

        <div class="col-md-3 mb-4">
            <div class="card shadow-sm">

                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Filtros</h5>
                </div>

                <div class="card-body">

                    @* FILTRO 1: NOMBRE *@
                    <div class="mb-3">
                        <label for="filterName" class="form-label">Nombre</label>
                        <input type="text" class="form-control" id="filterName"
                               @bind="filterName" @bind:event="oninput"
                               placeholder="Ej. Iphone..." />
                    </div>

                    @* FILTRO 2: COLOR *@
                    <div class="mb-3">
                        <label for="filterColor" class="form-label">Color</label>
                        <input type="text" class="form-control" id="filterColor"
                               @bind="filterColor" @bind:event="oninput"
                               placeholder="Ej. Rojo..." />
                    </div>

                    <button class="btn btn-outline-secondary w-100" @onclick="ClearFilters">
                        Limpiar Filtros
                    </button>

                </div>
            </div>

            <div class="card shadow-sm mt-3 border-success">
                <div class="card-body">
                    <h6 class="card-title text-success">Total Carrito</h6>
                    <h3 class="card-text">@PurchaseState.TotalPrice.ToString("C")</h3>
                    <p class="small text-muted">@PurchaseState.Purchase.PurchaseItems.Sum(i => i.Quantity) artículos</p>

                    @if (PurchaseState.Purchase.PurchaseItems.Any())
                    {
                        <button class="btn btn-success w-100" @onclick='() => NavigationManager.NavigateTo("/purchase/create")'>Tramitar</button>
                        @* ESTO SE IMPLEMETARA EN FUTURO*@
                    }
                </div>
            </div>

        </div> @*De col-md-3 mb-4*@


        <div class="col-md-9">
            @if (devices == null)
            {
                <div class="d-flex justify-content-center">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            }
            else if (!FilteredDevices.Any())
            {
                <div class="alert alert-warning" role="alert">
                    No se encontraron dispositivos con los filtros seleccionados.
                </div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                    @foreach (var device in FilteredDevices)
                    {
                        <div class="col">
                            <div class="card h-100 shadow-sm">
                                <div class="card-header text-center bg-light">
                                    <i class="bi bi-phone" style="font-size: 4rem; color: #6c757d;"></i>
                                </div>
                                <div class="card-body">
                                    <h5 class="card-title">@device.Brand @device.Name</h5> @*Con este cambio, debe salir el nombre correcto al aparecer en la seleccion*@
                                    <p class="card-text">
                                        <span class="badge bg-info text-dark">@device.Color</span>
                                    </p>
                                    <h4 class="text-primary text-end">@device.PriceForPurchase.ToString("C")</h4>
                                </div>
                                <div class="card-footer bg-white border-top-0">
                                    <button class="btn btn-primary w-100" @onclick="() => AddToCart(device)">
                                        <i class="bi bi-cart-plus"></i> Añadir
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div> @*De clase row*@
</div> @*De clase container*@


@*COMENTARIO: AQUI TODO LO RELACIONADO CON EL BACK-END*@
@code {

    // Lista para recibir los datos de la API
	private ICollection<DeviceParaCompraDTOs> devices;

    // Variables de filtro
    private string filterName = string.Empty;
    private string filterColor = string.Empty;


    // Propiedad calculada para el filtrado en memoria
    private IEnumerable<DeviceParaCompraDTOs> FilteredDevices
    {
        get
        {
            if (devices == null) return Enumerable.Empty<DeviceParaCompraDTOs>();

            var query = devices.AsEnumerable();

            // Lógica de filtrado por NOMBRE
            if (!string.IsNullOrWhiteSpace(filterName))
            {
                // Usamos d.Name porque es lo que busca el usuario
                query = query.Where(d => d.Name != null && d.Name.Contains(filterName, StringComparison.OrdinalIgnoreCase));
            }

            // Lógica de filtrado por COLOR
            if (!string.IsNullOrWhiteSpace(filterColor))
            {
                // Usamos d.Color
                query = query.Where(d => d.Color != null && d.Color.Contains(filterColor, StringComparison.OrdinalIgnoreCase));
            }

            return query;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            //var client = ClientFactory.CreateClient("API");
            // Asegurar ruta sea la correcta a tu controlador
            // CORRECCIÓN URL: Añadido /GetDevice porque controlador usa [action]
            // devices = await client.GetFromJsonAsync<List<DeviceParaCompraDTOs>>("api/Device/GetDevicesParaPurchase");
            devices = await client.GetDevicesParaPurchaseAsync(null, null);      ;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
            Logger.LogError(ex, "Error! There was an error while trying to get the list for filtered purchases");
            //Recordar que DECLARAMOS una colección, pero como no pudimos traer datos (en este caso), entonces creo una lista vacía, para que la pantalla no se rompa.
            devices = new List<DeviceParaCompraDTOs>();
        }
    }

    private void ClearFilters()
    {
        filterName = string.Empty;
        filterColor = string.Empty;
        
    }

    private void AddToCart(DeviceParaCompraDTOs device)
    {
        // CORRECCIÓN: Nombres exactos de propiedades
        var itemToAdd = new PurchaseItemDTO
        {
            //Revisar mayúsculas. Swagger suele convertir 'id' a 'Id' (PascalCase).
            
            Id = device.Id,
            Brand = device.Brand,
            Model = device.Model,
            Color = device.Color,
			UnitPrice = device.PriceForPurchase, //Nota, no poner decimal delante porque ya es decimal
            Quantity = 1,
            Description = ""
        };

        PurchaseState.AddDeviceToPurchase(itemToAdd); 
    }
}