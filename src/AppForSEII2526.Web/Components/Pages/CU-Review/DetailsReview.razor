@page "/Review/DetailsReview"


@using AppForSEII2526.Web.API
@using Microsoft.AspNetCore.Authorization
@inject AppForSEII2526APIClient apiservice

@attribute [AllowAnonymous]

<h3>Review Details</h3>

@if (review == null) {
    @if (string.IsNullOrEmpty(error)) {
        <p><em>Loading...</em></p>
    }
    else {
        <div class="alert alert-danger">@error</div>
    }
}
else {
    @* --- Cabecera de la Reseña (Paso 7: Datos del cliente, título, fecha) --- *@
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <h5 class="card-title text-primary">General Information</h5>
            <table class="table table-borderless table-sm mb-0">
                <tr>
                    <th style="width: 20%">Review Title</th>
                    <td id="ReviewTitle">@review.ReviewTitle</td>
                </tr>
                <tr>
                    <th>Date</th>
                    <td id="ReviewDate">@review.DateOfReview.ToString("dd/MM/yyyy HH:mm:ss")</td>
                </tr>
                <tr>
                    <th>Customer Name</th>
                    <td id="CustomerName">@review.NombreCliente</td>
                </tr>
                <tr>
                    <th>Country</th>
                    @* Llamamos a la función para convertir el número en texto *@
                    <td id="Country">@GetCountryName(review.PaisCliente)</td>
                </tr>
            </table>
        </div>
    </div>

    <h4>Reviewed Devices</h4>

    @* --- Tabla de Items (Paso 7: Mostrar datos de cada dispositivo) --- *@
    <div class="table-responsive">
        <table class="table table-hover align-middle" id="ReviewedDevices">
            <thead class="table-light">
                <tr>
                    <th scope="col">Device Name</th>
                    <th scope="col">Model</th>
                    <th scope="col">Year</th>
                    <th scope="col">Score (1-5)</th>
                    <th scope="col">Comment</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in review.ReviewItems) {
                    <tr id="ReviewItem_@item.DeviceId">
                        <td class="fw-bold">@item.DeviceName</td>
                        <td>@item.ModelName</td>
                        <td>@item.DeviceYear</td>
                        <td>
                            @* Renderizado visual de la puntuación *@
                            <span class="badge @GetBadgeClass(item.Rating)">
                                @item.Rating / 5
                            </span>
                        </td>
                        <td class="text-muted fst-italic">"@item.Comments"</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-3">
        <a href="/" class="btn btn-secondary">Back to Home</a>
    </div>
}
@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public int ReviewID { get; set; }

    private ReviewDetailDTO review;
    private string error = "";

    protected override async Task OnInitializedAsync() {
        try {
            // Llamada a la API para obtener la reseña por ID
            review = await apiservice.GetReviewAsync(ReviewID);
        }
        catch (ApiException ex) {
            error = $"Error loading review: {ex.Message}";
            review = null;
        }
        catch (Exception ex) {
            error = "An unexpected error occurred.";
            review = null;
        }
    }
    
    
    // Método para traducir el ID del país al Nombre
    private string GetCountryName(int countryId) {
        return countryId switch {
            1 => "Spain",
            5 => "France",
            10 => "Germany",
            20 => "Italy",
            _ => "Unknown Country" // Por si viene un valor no esperado
        };
    }

    // Método auxiliar para dar color a la nota (mejora la UI)
    private string GetBadgeClass(int rating) {
        return rating switch {
            5 => "bg-success", // Verde
            4 => "bg-info text-dark", // Azul claro
            3 => "bg-primary", // Azul
            2 => "bg-warning text-dark", // Amarillo
            _ => "bg-danger" // Rojo
        };
    }

}
