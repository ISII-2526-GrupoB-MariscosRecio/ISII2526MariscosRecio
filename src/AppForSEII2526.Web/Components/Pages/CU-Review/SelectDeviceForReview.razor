@page "/Review/SelectDeviceForReview"

@using Microsoft.AspNetCore.Authorization
@using AppForSEII2526.Web.API


@inject AppForSEII2526APIClient apiclient
@inject ILogger<SelectDeviceForReview> logger
@inject ReviewStateContainer reviewState
@inject NavigationManager navigation

@attribute [AllowAnonymous]

<h3>Select Devices for Review</h3>

<div class="container-fluid">
    @* --- Área de Errores --- *@
    <div class="row alert alert-danger" role="alert" hidden="@hideErrors">
        <p id="ErrorsShown" class="mb-0">@errors</p>
    </div>

    <div class="row">
        @* --- Columna Izquierda: Filtros y Tabla (9 columnas) --- *@
        <div class="col-md-9">

            @* --- Filtros de Búsqueda --- *@
            <div class="card mb-3">
                <div class="card-header bg-light">Filters</div>
                <div class="card-body">
                    @* USO DE 'row g-3 align-items-end': 
                       - g-3: Espacio entre columnas.
                       - align-items-end: Alinea los elementos abajo (para que el botón cuadre con los inputs).
                    *@
                    <div class="row g-3 align-items-end">

                        @* Filtro: Brand (4 columnas) *@
                        <div class="col-md-4">
                            <label for="selectBrand" class="form-label mb-1">Brand</label>
                            <select class="form-select" @bind="deviceBrandSelected" id="selectBrand">
                                <option value="All" selected>All Brands</option>
                                @foreach (string brandName in brandsNames) {
                                    <option value="@brandName">@brandName</option>
                                }
                            </select>
                        </div>

                        @* Filtro: Year (4 columnas) *@
                        <div class="col-md-4">
                            <label for="inputYear" class="form-label mb-1">Year</label>
                            <input type="number" class="form-control" @bind="deviceYearSelected" placeholder="0 for All" id="inputYear" />
                        </div>

                        @* Botón Buscar (4 columnas) *@
                        <div class="col-md-4">
                            <button type="button" class="btn btn-primary w-100" @onclick="@SearchDevices" id="searchDevices">
                                <i class="bi bi-search"></i> Search Devices
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            @* --- Tabla de Resultados --- *@
            <div class="row">
                @if (devices == null) {
                    <p><em>Loading devices...</em></p>
                }
                else if (devices.Count == 0) {
                    <div class="alert alert-warning">No devices found matching the criteria.</div>
                }
                else {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle" id="TableOfDevices">
                            <thead class="table-light">
                                <tr>
                                    <th>Name</th>
                                    <th>Brand</th>
                                    <th>Color</th>
                                    <th>Year</th>
                                    <th>Model</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var dev in devices) {
                                    <tr id="DeviceData_@dev.Id">
                                        <td>@dev.Name</td>
                                        <td>@dev.Brand</td>
                                        <td>@dev.Color</td>
                                        <td>@dev.Year</td>
                                        <td>@dev.Model</td>
                                        <td>
                                            @if (IsDeviceInCart(dev.Id)) {
                                                <button class="btn btn-success btn-sm" disabled>
                                                    <i class="bi bi-check"></i> Added
                                                </button>
                                            }
                                            else {
                                                <button class="btn btn-outline-primary btn-sm" id="deviceToReview_@dev.Id" @onclick="@(() => AddDevice(dev))">
                                                    Add to Review
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        @* --- Columna Derecha: Carrito de Reseñas (3 columnas) --- *@
        <div class="col-md-3">
            <div class="card border-primary mb-3 sticky-top" style="top: 20px;">

                @* CABECERA DEL CARRITO CON BOTÓN DE LIMPIAR *@
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <span>Review Cart (@review.ReviewItems.Count)</span>
                    @if (review.ReviewItems.Count > 0) {
                        @* Botón para limpiar todo *@
                        <button class="btn btn-sm btn-danger ms-2" @onclick="ClearCart" title="Remove All">
                            Clear
                        </button>
                    }
                </div>

                <div class="card-body">
                    @if (review.ReviewItems.Count == 0) {
                        <p class="text-muted small">No devices selected yet.</p>
                    }
                    else {
                        <ul class="list-group list-group-flush mb-3">
                            @foreach (ReviewItemDTO item in review.ReviewItems) {
                                <li class="list-group-item d-flex justify-content-between align-items-center p-2">
                                    <div class="lh-sm">
                                        <small class="fw-bold">@item.DeviceName</small><br />
                                        <small class="text-muted">@item.ModelName</small>
                                    </div>
                                    <button type="button" class="btn btn-outline-danger btn-sm py-0 px-1"
                                            id="removeDevice_@item.DeviceId"
                                            @onclick="@(() => RemoveReviewItem(item))"
                                            title="Remove">
                                        &times;
                                    </button>
                                </li>
                            }
                        </ul>
                    }

                    <div class="d-grid gap-2">
                        <button type="button" class="btn btn-primary" id="startReviewButton"
                                @onclick="@GoToReviewForm"
                                disabled="@(review.ReviewItems.Count == 0)">
                            Proceed to Review
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@code {
    private string deviceBrandSelected;
    private int deviceYearSelected = 0;
    private ICollection<string>? brandsNames = new List<string>();
    private bool hideReviewingCart { get { return review.ReviewItems.Count == 0; } }
    private ICollection<DeviceParaReseñasDTO> devices;
    private bool hideErrors { get { return errors.Length == 0; } }
    private string errors = "";
    [SupplyParameterFromQuery]
    public bool EditMode { get; set; }


    private ReviewForCreateDTO review => reviewState.Review;

    private bool hiddenReviewingCart = true;

    private void AddDevice(DeviceParaReseñasDTO device) {
        reviewState.AddDeviceToReview(device);
    }

    private void RemoveReviewItem(ReviewItemDTO item) {
        reviewState.RemoveReviewItemToReview(item);
        if (review.ReviewItems.Count == 0) hiddenReviewingCart = true;
    }

    public async Task SearchDevices() {
        // Lógica de filtrado de Marca
        string? brandFilter = deviceBrandSelected == "All" ? null : deviceBrandSelected;

        // Si el usuario deja el 0, manda null. Si pone un año manda el int.
        int? yearFilter = deviceYearSelected == 0 ? null : deviceYearSelected;

        try {
            // Se llama al API pasando los filtros
            devices = await apiclient.GetDevicesParaReviewAsync(brandFilter, yearFilter);
            errors = "";
        }
        catch (Exception ex) {
            logger.LogError($"{DateTime.Now} Error: {ex}");
            errors = "Error while connecting to the system";
        }
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync() {
        
        if (!EditMode) {
            review.ReviewItems.Clear();
           
        }
        try {
            //brandsNames = await apiclient.G
            // Simulación de datos para probar la interfaz
            brandsNames = new List<string> { "Samsung", "Apple", "Xiaomi", "Sony", "LG" };
            
        }
        catch (ApiException ex) {
            if (brandsNames == null) brandsNames = new List<string>() { "All", };
            logger.LogError("Error! There was an error while connecting to the GetGenresAsync service");
        }

        
        

        await SearchDevices(); 

    }

    private void ClearCart() {
        // Asumiendo que ReviewItems es una List<ReviewItemDTO>, podemos usar Clear()
        review.ReviewItems.Clear();
    }


    // Helper para verificar visualmente si ya está añadido
    private bool IsDeviceInCart(int deviceId) {
        return review.ReviewItems.Any(x => x.DeviceId == deviceId);
    }

    private void GoToReviewForm() {
        // Validar Flujo Alternativo 2: Si no hay dispositivos, no dejar continuar
        if (review.ReviewItems.Count == 0) {
            errors = "You must select at least one device to review.";
            return;
        }

        // Navegar a la pantalla del Paso 5 (Formulario de datos)
        navigation.NavigateTo("/Review/CreateReview");
    }

}