@page "/rental/RentalCreate"

@using Microsoft.AspNetCore.Authorization
@using AppForSEII2526.Web.API
@using AppForSEII2526.Web.Components.Shared

@inject NavigationManager navigation
@inject AppForSEII2526APIClient apiclient
@inject ILogger<RentalCreate> logger
@inject RentalStateContainer rentalState

@*
@attribute [Authorize]
*@


<h3>Create Rental</h3>

<EditForm Model="rental" OnValidSubmit="OpenDialog">
    <div class="row">
        <DataAnnotationsValidator />
        <ValidationSummary class="alert alert-danger" />
    </div>

    @if (!string.IsNullOrEmpty(messageError)) {
        <div class="row alert alert-danger" role="alert">
            <p>Error: @messageError</p>
        </div>
    }

    <div class="row g-3">
        @* 1. Email *@
        <div class="col-md-6">
            <div class="form-floating mb-3">
                <InputText @bind-Value="rental.CustomerUserName" class="form-control" id="CustomerUserName" />
                <label for="CustomerUserName">User Email</label>
                <ValidationMessage For="@(() => rental.CustomerUserName)" />
            </div>
        </div>

        @* 2. Nombre y Apellidos *@
        <div class="col-md-6">
            <div class="form-floating mb-3">
                <InputText @bind-Value="rental.CustomerNameSurname" class="form-control" id="NameSurname" />
                <label for="NameSurname">Name and Surname</label>
                <ValidationMessage For="@(() => rental.CustomerNameSurname)" />
            </div>
        </div>

        @* 3. Dirección *@
        <div class="col-12">
            <div class="form-floating mb-3">
                <InputText @bind-Value="rental.DeliveryAddress" class="form-control" id="DeliveryAddress" />
                <label for="DeliveryAddress">Delivery Address</label>
                <ValidationMessage For="@(() => rental.DeliveryAddress)" />
            </div>
        </div>
    </div>

    <div class="row g-2">
        @* 4. Pago *@
        <div class="col-md">
            <div class="form-floating">
                <InputSelect class="form-select" @bind-Value="rental.PaymentMethod" id="Credit Card">
                    @foreach (var method in Enum.GetValues(typeof(PaymentMethodTypes))) {
                        <option id ="PaymentMethod"value="@method">@method</option>
                    }
                </InputSelect>
                <label for="PaymentMethod">Payment Method</label>
            </div>
        </div>

        @* Botón *@
        <div class="col-md">
            <div class="form-floating">
                <button class="btn btn-primary w-100 h-100" id="btnSubmit" type="submit" disabled="@rentalButtonDisabled">
                    Rent your devices
                </button>
            </div>
        </div>
    </div>

    <h4 class="mt-4">Rental detail</h4>
    <p><b>Date from:</b> @rental.RentalDateFrom.ToString("dd/MM/yyyy") <b>to:</b> @rental.RentalDateTo.ToString("dd/MM/yyyy")</p>
    <p>
        @* Usamos tu cálculo del state, que es más limpio *@
        <b>Total price:</b> @rentalState.TotalPrice €
        <button type="button" id="btnModify" class="btn btn-outline-primary ms-2" @onclick="ModifyRentalItems">
            Modify devices
        </button>
    </p>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Device</th>
                    <th>Brand</th>
                    <th>Price</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in rental.RentalItems) {
                    <tr>
                        <td>@item.Model</td>
                        <td>@item.Brand</td>
                        <td>@item.RentPrice €</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</EditForm>

@if (DialogIsOpen) {
    <Dialog Caption="Rental devices"
            Message="Do you want to proceed to rent the selected devices?"
            OnClose="@OnDialogClose"
            Type="Dialog.Category.SaveNot">
    </Dialog>
}

@code {
    private RentalPostDTO rental => rentalState.Rental;
    private string messageError = "";

    // Control de botón igual que ella
    private bool rentalButtonDisabled { get { return (rental.RentalItems == null || rental.RentalItems.Count == 0); } }

    private bool DialogIsOpen = false;

    // Inicialización mínima para que no peten los nulos
    protected override void OnInitialized() {
        if (rentalButtonDisabled) {
            navigation.NavigateTo("/rental/selectdevices");
        }
        if (string.IsNullOrEmpty(rental.CustomerUserName)) rental.CustomerUserName = "";
    }

    private void OpenDialog() {
        DialogIsOpen = true;
    }

    private void ModifyRentalItems() {
        navigation.NavigateTo("/rental/selectdevices");
    }

    
    private async Task OnDialogClose(bool isOk) {
        DialogIsOpen = false;

        if (isOk) {
            // Doble chequeo de seguridad como ella
            if (rental.RentalItems.Count > 0) {
                try {
                    // 1. Llamada API
                    var rented = await apiclient.CreateRentalAsync(rental);

                    // 2. Limpiar Carrito
                    rentalState.RentalProcessed();

                    // 3. REDIRECCIÓN A LA PÁGINA DE DETALLE (La que vas a crear ahora)
                    navigation.NavigateTo($"/rental/detailrental/?RentalID={rented.Id}");
                }
                catch (ApiException<ValidationProblemDetails> apiexceptionvalidation) {
                    // Gestión de errores manual con foreach (Estilo Profesora)
                    if (apiexceptionvalidation.Result.Errors.Values != null) {
                        messageError = "";
                        foreach (var errors in apiexceptionvalidation.Result.Errors.Values) {
                            messageError = string.Join("(*) ", messageError, string.Join(" (*) ", errors));
                        }
                    }
                }
                catch (ApiException apiexception) {
                    messageError = "Error while processing your request, please try again later!";
                }
                catch (Exception) {
                    messageError = "Unknown error.";
                }
            }
        }
    }
    protected override async Task OnInitializedAsync() {
        // Primero verificamos si hay items (Seguridad)
        if (rentalButtonDisabled) {
            navigation.NavigateTo("/rental/selectdevices");
        }

        // Lógica de Autenticación (La del dólar)
        if (authenticationState is not null) {
            var authState = await authenticationState;
            var user = authState?.User;

            if (user is not null) {
                if (user.Identity is not null && user.Identity.IsAuthenticated) {
                    // ADAPTADO: Usamos 'CustomerUserName' en lugar de 'UserNameCustomer'
                    rental.CustomerUserName = user.Identity.Name;
                }
            }

            // ADAPTADO: Usamos 'CustomerNameSurname' e inicializamos a vacío si es null
            rental.CustomerNameSurname = rental.CustomerNameSurname == null ? "" : rental.CustomerNameSurname;

            // ADAPTADO: DeliveryAddress se queda igual
            rental.DeliveryAddress = rental.DeliveryAddress == null ? "" : rental.DeliveryAddress;
        }
    }
    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }
}