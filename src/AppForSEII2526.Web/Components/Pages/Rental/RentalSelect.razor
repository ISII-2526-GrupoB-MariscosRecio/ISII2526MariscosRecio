@page "/rental/selectdevices"

@using Microsoft.AspNetCore.Authorization
@using AppForSEII2526.Web.API

@inject AppForSEII2526APIClient apiclient
@inject ILogger<RentalSelect> logger
@inject RentalStateContainer rentalState
@inject NavigationManager navigation

<h3>Select Devices For Rental</h3>
<div class="container-fluid">
    @* Zona de Errores *@
    <div class="row alert alert-danger" role="alert" hidden="@hideErrors">
        <p id="ErrorsShown">Errors: @errors</p>
    </div>

    <div class="row">
        @* COLUMNA IZQUIERDA: BUSCADOR Y TABLA *@
        <div class="col-8">

            @* FILTROS *@
            <div class="row">
                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text">Modelo</span>
                        <input type="text" @bind="deviceModel" class="form-control" placeholder="Ej: Galaxy..." />
                    </div>
                </div>
                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text">Max Price</span>
                        <input type="number" @bind="rentPrice" class="form-control" />
                    </div>
                </div>

                @* Fechas *@
                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text">From</span>
                        <InputDate @bind-Value="@From" class="form-control" />
                    </div>
                </div>
                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text">To</span>
                        <InputDate @bind-Value="@To" class="form-control" />
                    </div>
                </div>

                <div class="col">
                    <button type="button" class="btn btn-primary" @onclick="@SearchDevice">Search</button>
                </div>
            </div>

            @* TABLA (Corregida: Quitada la columna Model repetida) *@
            <div class="row">
                @if (dispositivos == null) {
                    <p>Loading devices... (Click Search)</p>
                }
                else if (dispositivos.Count == 0) {
                    <p>No devices found.</p>
                }
                else {
                    <div class="mh-100 table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>Device Name</th> @* Aquí saldrá Galaxy S10 *@
                                    <th>Brand</th>       @* Aquí saldrá Samsung *@
                                    <th>Year</th>
                                    <th>Color</th>
                                    <th>Price/Day</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var device in dispositivos) {
                                    <tr>
                                        <td>@device.Name</td>
                                        <td>@device.Brand</td>
                                        <td>@device.Year</td>
                                        <td>@device.Color</td>
                                        <td>@device.RentPrice €</td>
                                        <td>
                                            <button class="btn btn-success btn-sm" @onclick="@(() => AddDevice(device))">Add</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        @* COLUMNA DERECHA: CARRITO *@
        <div class="col-4" hidden="@hideRentingCart">
            <div class="card border-primary">
                <div class="card-header bg-primary text-white">
                    <h3>Shopping Cart</h3>
                </div>
                <ul class="list-group list-group-flush">
                    @foreach (var item in rental.RentalItems) {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            @* Ahora aquí saldrá el nombre correcto *@
                            <span>@item.Model (@item.Quantity)</span>
                            <span class="badge bg-secondary">@item.RentPrice €/day</span>
                            <button type="button" class="btn btn-danger btn-sm ms-2" @onclick="@(() => RemoveRentalItem(item))">X</button>
                        </li>
                    }
                </ul>
                <div class="card-footer text-end">
                    <h5>Total: @rentalState.TotalPrice €</h5>
                    <button type="button" class="btn btn-success w-100 mt-2" @onclick="@RentDevices">Confirm Rental</button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    // Variables
    private bool hideRentingCart { get { return rental.RentalItems.Count == 0; } }
    private ICollection<DeviceParaRentDTO> dispositivos;
    private bool hideErrors { get { return errors.Length == 0; } }
    private string errors = "";

    private string deviceModel { get; set; }
    private double? rentPrice { get; set; }

    private DateTime _from;
    private DateTime From {
        get { return _from; }
        set {
            if (_from != value) {
                _from = value;
                rental.RentalDateFrom = DateTime.SpecifyKind(_from, DateTimeKind.Utc);
                rentalState.ClearRentingCart();
            }
        }
    }
    private DateTime _to;
    private DateTime To {
        get { return _to; }
        set {
            if (_to != value) {
                _to = value;
                rental.RentalDateTo = DateTime.SpecifyKind(_to, DateTimeKind.Utc);
                rentalState.ClearRentingCart();
            }
        }
    }
    private RentalPostDTO rental => rentalState.Rental;

    // --- AQUÍ ESTÁ EL TRUCO DEL NOMBRE ---
    private void AddDevice(DeviceParaRentDTO device) {
        // Truco: Copiamos el Nombre (Galaxy S10) en el campo Model,
        // porque el carrito muestra 'item.Model'. Así sale bonito.
        device.Model = device.Name;

        rentalState.AddDeviceToRental(device);
    }

    private void RemoveRentalItem(RentalItemDTO item) {
        rentalState.RemoveRentalItemToRent(item);
    }

    public async void SearchDevice() {
        if (rental.RentalDateFrom > rental.RentalDateTo) {
            errors = "Fechas incorrectas"; return;
        }
        try {
            dispositivos = await apiclient.GetDevicesParaRentAsync(deviceModel, rentPrice);
            errors = "";
        }
        catch (Exception) { errors = "Error de conexión"; }
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync() {
        _from = (_from == default) ? DateTime.SpecifyKind(DateTime.Today.AddDays(1), DateTimeKind.Utc) : _from;
        rental.RentalDateFrom = _from;
        _to = (_to == default) ? DateTime.SpecifyKind(DateTime.Today.AddDays(2), DateTimeKind.Utc) : _to;
        rental.RentalDateTo = _to;
        SearchDevice();
    }

    private void RentDevices() {
        navigation.NavigateTo("/rental/RentalCreate");
    }
}